{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seedream Template Spec V0.4 (V0.3 and legacy readable)",
  "oneOf": [
    {
      "$ref": "template-spec-v04.schema.json"
    },
    {
      "$ref": "#/$defs/v03"
    },
    {
      "$ref": "#/$defs/legacy"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "priority": {
      "enum": [
        "MUST",
        "PREFERRED"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "priority",
        "score2",
        "score1",
        "score0"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[TV][0-9]{2}$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "score2": {
          "$ref": "#/$defs/text"
        },
        "score1": {
          "$ref": "#/$defs/text"
        },
        "score0": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "alignmentDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "level",
        "score",
        "commonPattern",
        "variation",
        "coverage",
        "reason",
        "conflictingReferences",
        "severeConflict"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "score": {
          "enum": [
            0,
            25,
            50,
            75,
            100
          ]
        },
        "commonPattern": {
          "$ref": "#/$defs/text"
        },
        "variation": {
          "type": "string"
        },
        "coverage": {
          "enum": [
            "ALL",
            "ALMOST_ALL",
            "MULTIPLE_MODES",
            "WEAK",
            "CONFLICTED"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "conflictingReferences": {
          "$ref": "#/$defs/strings"
        },
        "severeConflict": {
          "type": "boolean"
        }
      }
    },
    "alignmentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "status",
        "severeConflict",
        "reason",
        "dimensions"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "severeConflict": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alignmentDimension"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "rationale"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "p0Advantage",
        "p1Supported",
        "p2BoundaryNotRecommended"
      ],
      "properties": {
        "status": {
          "const": "INITIAL_HYPOTHESIS"
        },
        "p0Advantage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "p1Supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "p2BoundaryNotRecommended": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "testPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "rows"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/text"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "testId",
              "tier",
              "inputDescription",
              "challengeVariable",
              "inputCount",
              "runsPerInput",
              "totalOutputs"
            ],
            "properties": {
              "testId": {
                "type": "string",
                "pattern": "^P[0-2]-[0-9]{2}$"
              },
              "tier": {
                "enum": [
                  "P0",
                  "P1",
                  "P2"
                ]
              },
              "inputDescription": {
                "$ref": "#/$defs/text"
              },
              "challengeVariable": {
                "$ref": "#/$defs/text"
              },
              "inputCount": {
                "type": "integer",
                "minimum": 1
              },
              "runsPerInput": {
                "type": "integer",
                "minimum": 1
              },
              "totalOutputs": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "v03": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specVersion",
        "templateName",
        "runtimeInput",
        "runtimeInputInferred",
        "usageScenario",
        "alignment",
        "targetVisual",
        "heroReference",
        "templateRuleSearch",
        "templateRules",
        "visualQualityRules",
        "ruleQualityReview",
        "initialApplicability",
        "fitTestPlan",
        "tuneTestPlan",
        "promptVersion",
        "seedreamPrompt",
        "promptRuleMap"
      ],
      "properties": {
        "specVersion": {
          "const": "0.3"
        },
        "templateName": {
          "$ref": "#/$defs/text"
        },
        "runtimeInput": {
          "enum": [
            "Text only",
            "Single image",
            "Multiple images"
          ]
        },
        "runtimeInputInferred": {
          "type": "boolean"
        },
        "usageScenario": {
          "$ref": "#/$defs/text"
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "visual",
            "intent",
            "conflicts",
            "recommendations"
          ],
          "properties": {
            "status": {
              "enum": [
                "ALIGNED",
                "NOT ALIGNED"
              ]
            },
            "visual": {
              "$ref": "#/$defs/alignmentPart"
            },
            "intent": {
              "allOf": [
                {
                  "$ref": "#/$defs/alignmentPart"
                },
                {
                  "properties": {
                    "dimensions": {
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              ]
            },
            "conflicts": {
              "$ref": "#/$defs/strings"
            },
            "recommendations": {
              "$ref": "#/$defs/strings"
            }
          }
        },
        "targetVisual": {
          "type": "string"
        },
        "heroReference": {
          "type": "string"
        },
        "templateRuleSearch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "disposition",
              "rationale"
            ],
            "properties": {
              "candidate": {
                "$ref": "#/$defs/text"
              },
              "disposition": {
                "enum": [
                  "RETAINED",
                  "MERGED",
                  "PRUNED"
                ]
              },
              "rationale": {
                "$ref": "#/$defs/text"
              },
              "ruleId": {
                "type": "string",
                "pattern": "^T[0-9]{2}$"
              },
              "overlapTarget": {
                "type": "string",
                "pattern": "^[TV][0-9]{2}$"
              }
            }
          }
        },
        "templateRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "visualQualityRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "ruleQualityReview": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "stableFeatures",
              "allowedVariation",
              "identityFeatures",
              "coverageComplete"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "pattern": "^V0[1-6]$"
              },
              "stableFeatures": {
                "$ref": "#/$defs/strings"
              },
              "allowedVariation": {
                "$ref": "#/$defs/strings"
              },
              "identityFeatures": {
                "$ref": "#/$defs/strings"
              },
              "coverageComplete": {
                "const": true
              }
            }
          }
        },
        "initialApplicability": {
          "$ref": "#/$defs/applicability"
        },
        "fitTestPlan": {
          "$ref": "#/$defs/testPlan"
        },
        "tuneTestPlan": {
          "$ref": "#/$defs/testPlan"
        },
        "promptVersion": {
          "type": "string",
          "pattern": "^(0\\.0|[1-9][0-9]*\\.[0-9]+)$"
        },
        "seedreamPrompt": {
          "type": "string"
        },
        "promptRuleMap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sentence",
              "ruleIds"
            ],
            "properties": {
              "sentence": {
                "$ref": "#/$defs/text"
              },
              "ruleIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[TV][0-9]{2}$"
                }
              }
            }
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "required": [
        "templateName",
        "runtimeInput",
        "runtimeInputInferred",
        "alignment",
        "targetVisual",
        "visualDNA",
        "keywords",
        "must",
        "avoid",
        "seedreamPrompt"
      ],
      "properties": {
        "specVersion": {
          "enum": [
            "0.2"
          ]
        },
        "templateName": {
          "$ref": "#/$defs/text"
        },
        "runtimeInput": {
          "enum": [
            "Text only",
            "Single image",
            "Multiple images"
          ]
        },
        "runtimeInputInferred": {
          "type": "boolean"
        },
        "alignment": {
          "type": "object"
        },
        "targetVisual": {
          "type": "string"
        },
        "visualDNA": {
          "type": "object"
        },
        "keywords": {
          "type": "array"
        },
        "must": {
          "type": "array"
        },
        "avoid": {
          "type": "array"
        },
        "initialApplicability": {
          "type": "object"
        },
        "seedreamPrompt": {
          "type": "string"
        }
      }
    }
  }
}
