{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Seedream FIT Analysis V0.2","type":"object","additionalProperties":false,
  "required":["reportType","schemaVersion","templateName","lineageId","sourceBatch","model","promptVersion","caseCount","ruleScores","summaryScores","hardGates","status","promptOptimizationRecommended","recommendedActions","capabilitySignals","failures","candidateRules","tunePriorities","recommendations","riskFlags"],
  "properties":{
    "reportType":{"const":"FIT"},"schemaVersion":{"const":"0.2"},"templateName":{"$ref":"#/$defs/text"},"lineageId":{"$ref":"#/$defs/id"},"sourceBatch":{"$ref":"#/$defs/id"},"model":{"$ref":"#/$defs/text"},"promptVersion":{"$ref":"#/$defs/text"},"caseCount":{"type":"integer","minimum":1},
    "ruleScores":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ruleScore"}},"summaryScores":{"$ref":"#/$defs/summary"},"hardGates":{"$ref":"#/$defs/gates"},"status":{"enum":["GO","CONDITIONAL","STOP"]},"promptOptimizationRecommended":{"type":"boolean"},"recommendedActions":{"type":"array","items":{"enum":["CONTINUE_TUNING","NARROW_APPLICABILITY","MODIFY_TEMPLATE_DEFINITION","DROP_TEMPLATE"]}},
    "capabilitySignals":{"$ref":"#/$defs/texts"},"failures":{"type":"array","items":{"$ref":"#/$defs/failure"}},"candidateRules":{"type":"array","items":{"$ref":"#/$defs/candidate"}},"tunePriorities":{"type":"array","maxItems":10,"uniqueItems":true,"items":{"type":"string","pattern":"^[RTV][0-9]{2,}$"}},"recommendations":{"$ref":"#/$defs/texts"},"riskFlags":{"$ref":"#/$defs/texts"}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":"\\S"},"texts":{"type":"array","items":{"$ref":"#/$defs/text"}},"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"priority":{"enum":["MUST","PREFERRED"]},
    "outputScore":{"type":"object","additionalProperties":false,"required":["caseId","outputId","applicable","score"],"properties":{"caseId":{"$ref":"#/$defs/id"},"outputId":{"$ref":"#/$defs/id"},"applicable":{"type":"boolean"},"score":{"type":["integer","null"],"minimum":0,"maximum":2},"note":{"type":"string"}}},
    "ruleScore":{"type":"object","additionalProperties":false,"required":["ruleId","priority","scores","actualPoints","maxPoints","score"],"properties":{"ruleId":{"type":"string","pattern":"^[RTV][0-9]{2,}$"},"priority":{"$ref":"#/$defs/priority"},"scores":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/outputScore"}},"actualPoints":{"type":"integer","minimum":0},"maxPoints":{"type":"integer","minimum":2},"score":{"type":"number","minimum":0,"maximum":100}}},
    "summary":{"type":"object","additionalProperties":false,"required":["overall","must","preferred"],"properties":{"overall":{"type":"number","minimum":0,"maximum":100},"must":{"type":"number","minimum":0,"maximum":100},"preferred":{"type":"number","minimum":0,"maximum":100}}},
    "gates":{"type":"object","additionalProperties":false,"required":["overallPass","mustPassRatePass","everyMustRulePassRatePass","pass"],"properties":{"overallPass":{"type":"boolean"},"mustPassRatePass":{"type":"boolean"},"everyMustRulePassRatePass":{"type":"boolean"},"pass":{"type":"boolean"}}},
    "frequency":{"type":"object","additionalProperties":false,"required":["count","total"],"properties":{"count":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":1}}},
    "failure":{"type":"object","additionalProperties":false,"required":["id","name","description","relatedRules","frequency","severity","promptFixability","evidenceCases","evidenceOutputs"],"properties":{"id":{"type":"string","pattern":"^F[0-9]{2}$"},"name":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"relatedRules":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[RTV][0-9]{2,}$"}},"frequency":{"$ref":"#/$defs/frequency"},"severity":{"enum":["High","Medium","Low"]},"promptFixability":{"enum":["High","Medium","Low"]},"evidenceCases":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"evidenceOutputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["id","name","text","reason","proposedPriority","uxDecision"],"properties":{"id":{"type":"string","pattern":"^N[0-9]{2}$"},"name":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},"proposedPriority":{"$ref":"#/$defs/priority"},"uxDecision":{"enum":["PENDING","ACCEPT","MERGE","REJECT"]},"mergeTarget":{"type":"string","pattern":"^[RTV][0-9]{2,}$"}}}
  }
}
