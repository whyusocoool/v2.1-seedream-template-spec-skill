{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Seedream Tuning Analysis V0.2","type":"object","additionalProperties":false,
  "required":["reportType","schemaVersion","templateName","lineageId","sourceBatch","promptRevision","changeLog","scoreSheets"],
  "properties":{
    "reportType":{"enum":["TUNE_ROUND_1","TUNE_COMPARISON"]},"schemaVersion":{"const":"0.2"},"templateName":{"$ref":"#/$defs/text"},"lineageId":{"$ref":"#/$defs/id"},"sourceBatch":{"$ref":"#/$defs/id"},"baselineBatch":{"$ref":"#/$defs/id"},"candidateBatch":{"$ref":"#/$defs/id"},"evaluatedBatch":{"$ref":"#/$defs/id"},"testedPromptVersion":{"$ref":"#/$defs/text"},"testedPromptSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"functionalRevisionCount":{"type":"integer","minimum":1,"maximum":3},
    "promptRevision":{"$ref":"#/$defs/revision"},"changeLog":{"type":"array","items":{"$ref":"#/$defs/change"}},"notChanged":{"type":"array","items":{"$ref":"#/$defs/text"}},"expectedImprovement":{"type":"array","items":{"$ref":"#/$defs/text"}},"scoreSheets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sheet"}},"comparisons":{"type":"array","items":{"$ref":"#/$defs/comparison"}},"nextAction":{"enum":["CALIBRATE_RELEASE","TEST_REVISION","TEST_FINAL_PATCH","STOP"]},"releaseCandidatePrompt":{"$ref":"#/$defs/revision"},"optionalFinalPatch":{"type":"object"},"promptChangeReview":{"type":"array","items":{"$ref":"#/$defs/promptReview"}},"evidenceAppendix":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":"\\S"},"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"ruleId":{"type":"string","pattern":"^[RTV][0-9]{2,}$"},
    "revision":{"type":"object","additionalProperties":false,"required":["version","targetRules","revisionHypothesis","text","functionalRevision"],"properties":{"version":{"$ref":"#/$defs/text"},"targetRules":{"type":"array","items":{"$ref":"#/$defs/ruleId"}},"revisionHypothesis":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"},"functionalRevision":{"type":"boolean"},"changeNotes":{"type":"string"}}},
    "change":{"type":"object","additionalProperties":false,"required":["id","description","targetRules"],"properties":{"id":{"type":"string","pattern":"^CHANGE-[0-9]{2}$"},"description":{"$ref":"#/$defs/text"},"targetRules":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ruleId"}}}},
    "sheet":{"type":"object","additionalProperties":false,"required":["promptVersion","overallScore","mustScore","preferredScore","gateResult","ruleScores"],"properties":{"promptVersion":{"$ref":"#/$defs/text"},"overallScore":{"type":"number","minimum":0,"maximum":100},"mustScore":{"type":"number","minimum":0,"maximum":100},"preferredScore":{"type":"number","minimum":0,"maximum":100},"tunePriorityScore":{"type":"number","minimum":0,"maximum":100},"gateResult":{"enum":["PASS","FAIL"]},"ruleScores":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["ruleId","score"],"properties":{"ruleId":{"$ref":"#/$defs/ruleId"},"score":{"type":"number","minimum":0,"maximum":100}}}}}},
    "comparison":{"type":"object","additionalProperties":false,"required":["ruleId","initialScore","finalScore","outcome","note"],"properties":{"ruleId":{"$ref":"#/$defs/ruleId"},"initialScore":{"type":"number","minimum":0,"maximum":100},"finalScore":{"type":"number","minimum":0,"maximum":100},"outcome":{"enum":["SOLVED","IMPROVED","UNCHANGED","REGRESSED","MODEL-LIMITED"]},"note":{"$ref":"#/$defs/text"}}},
    "promptReview":{"type":"object","additionalProperties":false,"required":["ruleId","originalSentence","finalSentence","initialScore","finalScore","explanation"],"properties":{"ruleId":{"$ref":"#/$defs/ruleId"},"originalSentence":{"type":"string"},"finalSentence":{"type":"string"},"initialScore":{"type":"number"},"finalScore":{"type":"number"},"explanation":{"$ref":"#/$defs/text"}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["caseId","inputAssets","outputsByVersion"],"properties":{"caseId":{"$ref":"#/$defs/id"},"inputAssets":{"type":"array","items":{"type":"string"}},"outputsByVersion":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}}}}
  }
}
